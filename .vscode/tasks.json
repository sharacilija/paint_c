{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build SDL2 project",
            "type": "shell",
            "command": "C:/msys64/mingw64/bin/gcc.exe",
            "args": [
                "-Wall",
                "-Wextra",
                "-g",
                "paint.c",
                "-o",
                "paint.exe",
                "-IC:/msys64/mingw64/include/SDL2",
                "-LC:/msys64/mingw64/lib",
                "-lmingw32",
                "-lSDL2main",
                "-lSDL2"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}